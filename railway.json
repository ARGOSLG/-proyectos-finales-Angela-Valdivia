{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildArgs": {
      "CACHEBUST": "1"
    }
  },
  "deploy": {
    "startCommand": "/bin/bash -c 'php artisan migrate --force && nginx -g \"daemon off;\" & php-fpm'",
    "healthcheckPath": "/up",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}